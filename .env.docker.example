# ========================================
# Network Bot Docker 环境变量配置示例
# ========================================
#
# 使用说明:
# 1. 复制此文件为 .env.docker
#    cp .env.docker.example .env.docker
#
# 2. 修改配置项为实际值
# 3. .env.docker 不会被提交到 git（已在 .gitignore 中忽略）
#

# ========================================
# 企业微信智能机器人配置（必填）
# ========================================
BOT_ID=your_bot_id_here
BOT_SECRET=your_bot_secret_here

# ========================================
# 服务配置
# ========================================
PORT=3000
NODE_ENV=production

# ========================================
# Claude AI 配置（必填）
# ========================================
# Claude API Key（从 https://console.anthropic.com/ 获取）
CLAUDE_API_KEY=your_claude_api_key_here

# Claude CLI 路径（容器内默认为 claude）
CLAUDE_CLI_PATH=claude

# Claude 思考深度配置
# 可选值: low | medium | high | xhigh | max
CLAUDE_THINKING_EFFORT=high

# ========================================
# Anthropic API 高级配置（可选）
# ========================================
# 如果设置了这些变量，Claude CLI 会优先使用它们
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ========================================
# 会话管理
# ========================================
# 会话超时时间（毫秒），默认 30 分钟
SESSION_TIMEOUT=1800000

# 最大并发会话数
MAX_CONCURRENT_SESSIONS=50

# Claude 工作区路径（容器内路径）
WORKSPACE_BASE_PATH=/tmp/claude-workspace

# ========================================
# 权限控制（可选）
# ========================================
# 允许使用机器人的用户 ID 列表（逗号分隔）
# 留空表示允许所有用户
# 示例: ALLOWED_USERS=user1,user2,user3
ALLOWED_USERS=

# ========================================
# 消息配置
# ========================================
# 单条消息最大长度限制
MAX_MESSAGE_LENGTH=10000

# ========================================
# MCP 配置
# ========================================
# MCP 配置文件路径（容器内路径）
MCP_CONFIG_PATH=/app/mcp-config.json
